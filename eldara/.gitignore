# Werkzeug- und Editor-Verzeichnisse
.claude/
.vscode/
.idea/

# Betriebssystem-Krempel
Thumbs.db
desktop.ini
.DS_Store

# Lokale Notizen und Zwischenstände, die nicht ins Repo gehören
*.local
*.log
*.tmp
node_modules/
__pycache__/
*.pyc

# Eigene Sounds und Charakterdaten bleiben lokal
custom_sound.*
mein_charakter*.json

# Einmal-Werkzeug zum Bereinigen der History (PII im Klartext) - nach Gebrauch loeschen
/.scrub/

# Rohdaten der Spielgruppen fuer die Regelpakete (privat, nur lokal fuer den Konverter)
/hausregeln/quellen/

# Rohdaten der Zufallsgenerator-Tabellen (privat, nur lokal fuer den Konverter)
/randomizer/quellen/

# Roh-Bildgenerierungen fuer Kartensymbole (unbearbeitet, gross) - das fertige
# Ergebnis steckt kleingerechnet in seekampf-icons.js
/hausregeln/map/
